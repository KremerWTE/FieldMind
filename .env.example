# Copy this file to .env and fill in real values before running docker-compose.full.yml
# For Azure App Service, set these as Application Settings (__ replaces : for nested keys)

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme
# Production override: ConnectionStrings__DefaultConnection
# e.g. Host=<host>;Port=5432;Database=fieldmind;Username=fieldmind;Password=<password>;SSL Mode=Require

# ── API ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-at-least-64-char-random-secret
# Production override: JWT__Secret

FRONTEND_URL=http://localhost:3000
# Production override: Frontend__Url (e.g. https://app.fieldmind.io)

# ── Monitoring ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
MONITORING_API_KEY=change-this-in-production
# Production override: Monitoring__ApiKey

# ── AWS S3 (photo storage) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=fieldmind-photos-dev
AWS_REGION=us-east-1
# Production overrides: AWS__AccessKeyId, AWS__SecretAccessKey
# Production bucket is set in appsettings.Production.json

# ── SendGrid (email) ──────────────────────────────────────────────────────────
# Get API key from https://app.sendgrid.com/settings/api_keys
# Production override: Email__SmtpPassword
SENDGRID_API_KEY=

# ── Twilio (SMS PIN delivery) ─────────────────────────────────────────────────
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15550000000
# Production overrides: Twilio__AccountSid, Twilio__AuthToken, Twilio__FromNumber

# ── OpenAI (AI photo analysis) ───────────────────────────────────────────────
OPENAI_API_KEY=
# Production override: AI__OpenAI__ApiKey

# ── Observability ─────────────────────────────────────────────────────────────
SEQ_API_KEY=monitoring-key
GRAFANA_PASSWORD=admin
