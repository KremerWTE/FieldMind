# Copy this file to .env and fill in real values before running docker-compose.full.yml

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme

# ── API ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-at-least-32-char-random-secret

FRONTEND_URL=http://localhost:3000

# ── AWS S3 (photo storage) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=fieldmind-photos-dev
AWS_REGION=us-east-1

# ── Twilio (SMS PIN delivery) ─────────────────────────────────────────────────
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15550000000

# ── OpenAI (AI photo analysis) ───────────────────────────────────────────────
OPENAI_API_KEY=

# ── Observability ─────────────────────────────────────────────────────────────
SEQ_API_KEY=monitoring-key
GRAFANA_PASSWORD=admin
