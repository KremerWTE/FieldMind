# Copy to .env and set the correct API URL

# For local dev on a simulator: localhost works
# For real device testing via Expo Go: use your machine's local IP
#   Windows: run `ipconfig` and look for IPv4 Address (e.g. 192.168.1.100)
#   Mac: run `ifconfig | grep "inet " | grep -v 127`
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:3001

EXPO_PUBLIC_API_URL=http://localhost:3001
