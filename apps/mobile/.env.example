# Copy to .env and set the correct API URL
#
# LOCAL DEV (simulator):       EXPO_PUBLIC_API_URL=http://localhost:3001
# LOCAL DEV (physical device): use your machine's LAN IP
#   Windows: run `ipconfig` → look for IPv4 Address (e.g. http://192.168.1.100:3001)
#   Mac:     run `ifconfig | grep "inet " | grep -v 127`
# PRODUCTION:                  EXPO_PUBLIC_API_URL=https://api.fieldmind.io
#
# For EAS builds (eas.json), set this in eas.json env block or in the
# Expo dashboard under Project → Environment Variables.

EXPO_PUBLIC_API_URL=http://localhost:3001
